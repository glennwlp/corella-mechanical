---
import Pic from './Pic.astro';
interface Props { crumbs: [string, string?][]; title: string; lead: string; image: string; alt: string; tag?: [string, string]; tagPos?: string; pos?: string }
const { crumbs, title, lead, image, alt, tag, tagPos = 'lg:left-[12%] lg:top-[26%]', pos } = Astro.props;
---
<section style="--lw:763px" class="split bg-ink text-white lg:grid lg:min-h-[540px] lg:grid-cols-[minmax(0,53%)_minmax(0,47%)]">
  <Pic name={image} alt={alt} eager pos={pos} class="h-[300px] sm:h-[400px] lg:order-2 lg:h-auto" sizes="(min-width:1024px) 47vw, 100vw" widths={[480, 800, 1200]}>
    {tag && <span class:list={['tag absolute bottom-5 left-5 lg:bottom-auto', tagPos]}><span><b>{tag[0]}</b><span>{tag[1]}</span></span></span>}
  </Pic>
  <div class="wrap flex flex-col justify-center py-8 sm:py-12 lg:order-1 lg:!pr-12 lg:py-20">
    <nav aria-label="Breadcrumb" class="crumbs text-[13.5px] text-steel">
      {crumbs.map(([l, h], i) => <>{i > 0 && <span class="mx-1.5">/</span>}{h ? <a href={h} class="hover:text-white">{l}</a> : <span aria-current="page">{l}</span>}</>)}
    </nav>
    <h1 class="h1 mt-4 lg:mt-6" set:html={title} />
    <p class="mt-5 max-w-[580px] text-[16px] leading-relaxed text-mist sm:text-[18px]">{lead}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-start"><slot /></div>
  </div>
</section>
