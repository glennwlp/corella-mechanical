---
import Pic from './Pic.astro';
import type { Project } from '../data/projects';
interface Props { p: Project; blurb: string; label?: string }
const { p, blurb, label = 'Featured project' } = Astro.props;
---
<section class="split-r bg-ink text-white lg:grid lg:min-h-[640px] lg:grid-cols-2">
  <Pic name={p.img} alt={p.title} class="h-[280px] sm:h-[420px] lg:h-auto" sizes="(min-width:1024px) 50vw, 100vw" widths={[480, 800, 1200]}>
    <span class="tag absolute top-5 left-5 lg:top-12 lg:left-[69px]"><span><b>{p.code}</b><span>{p.sector}, {p.place}</span></span></span>
  </Pic>
  <div class="relative flex flex-col justify-center px-5 py-12 sm:px-10 lg:px-20 lg:py-24">
    <p class="text-[14px] font-semibold text-steel">{label}</p>
    <h2 class="mt-3 max-w-[540px] text-[32px] leading-[1.08] sm:text-[44px]">{p.title}</h2>
    <p class="mt-5 max-w-[520px] text-[16px] leading-relaxed text-fog sm:text-[17px]">{blurb}</p>
    <dl class="mt-8 grid max-w-[480px] grid-cols-3 gap-4">{p.stats.map(([a, b]) => <div><dt class="font-display text-[34px] font-bold leading-none sm:text-[44px]">{a}</dt><dd class="mt-2 text-[13px] text-steel sm:text-[14px]">{b}</dd></div>)}</dl>
    <a href={`/projects/${p.slug}/`} class="ulink mt-8 self-start text-[15px] font-semibold">Read the case study</a>
    <p class="mt-6 text-[12px] text-mute-2 lg:absolute lg:right-12 lg:bottom-10 lg:mt-0">Figures are samples.</p>
  </div>
</section>
