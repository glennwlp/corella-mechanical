---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { nav, phone, tel, branches } from '../data/site';
interface Props { title: string; description: string; active?: string }
const { title, description, active = '' } = Astro.props;
const { sydney: s, newcastle: n } = branches;
const fServices = [['Commercial HVAC', '/commercial/'], ['Maintenance contracts', '/maintenance-contracts/'], ['24/7 breakdowns', '/maintenance-contracts/#breakdowns'], ['Premium residential', '/residential/'], ['Industries served', '/industries/']];
const fCompany = [['Projects', '/projects/'], ['About Corella', '/about/'], ['Careers', '/about/#careers'], ['Request a proposal', '#proposal'], ['Contact', '/contact/']];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="antialiased">
  <a href="#main" class="sr-only z-[100] bg-orange px-4 py-2 font-semibold focus:not-sr-only focus:fixed focus:top-2 focus:left-2">Skip to content</a>
  <div class="bg-ink text-[12.5px] text-mist sm:text-[13.5px]">
    <div class="wrap flex min-h-9 items-center justify-between gap-4 py-1.5 lg:min-h-10">
      <p class="flex flex-wrap items-center gap-x-2"><span class="hidden md:inline">Commercial HVAC breakdown? 24/7 response across Sydney and the Hunter:</span><span class="md:hidden">24/7 commercial breakdowns:</span> <a href={tel} class="inline-flex items-center gap-1.5 font-semibold text-white hover:text-orange"><Icon name="phone" size={14} class="text-orange" />{phone}</a></p>
      <p class="hidden gap-7 text-[13px] text-steel lg:flex"><a href={s.tel} class="hover:text-white">Silverwater&nbsp; {s.phone}</a><a href={n.tel} class="hover:text-white">Mayfield West&nbsp; {n.phone}</a></p>
    </div>
  </div>
  <header class="sticky top-0 z-50 border-b border-line/60 bg-white">
    <div class="wrap flex h-16 items-center justify-between gap-4 xl:h-[88px] xl:!px-8 min-[1400px]:!px-24">
      <span class="xl:hidden"><Logo small /></span><span class="hidden xl:inline"><Logo /></span>
      <nav class="hidden h-full items-stretch xl:flex" aria-label="Main">
        <ul class="flex h-full items-stretch gap-0.5">
          {nav.map((i) => (
            <li class="group relative flex">
              <a href={i.href} class:list={['relative flex items-center gap-1 px-2 text-[14.5px] font-medium whitespace-nowrap hover:text-orange-dark 2xl:px-3', active === i.key && 'font-semibold after:absolute after:inset-x-2 after:bottom-0 after:h-[3px] after:bg-orange']} aria-current={active === i.key ? 'page' : undefined}>{i.label}{i.children && <Icon name="chev" size={14} />}</a>
              {i.children && (
                <div class="invisible absolute top-full left-0 w-64 border border-line bg-white p-2 opacity-0 shadow-lg transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                  {i.children.map(([a, b, h]) => <a href={h} class="block px-4 py-3 hover:bg-bg-2"><span class="block font-display text-[19px] font-bold">{a}</span><span class="text-[13px] text-slate">{b}</span></a>)}
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <a href="#proposal" class="btn btn-orange hidden !min-h-[46px] !px-5 !text-[14px] xl:inline-flex">Request a Proposal</a>
      <div class="flex items-center gap-2 xl:hidden">
        <a href={tel} class="grid size-11 place-items-center bg-orange text-ink" aria-label={`Call ${phone}`}><Icon name="phone" size={20} /></a>
        <button type="button" class="grid size-11 place-items-center bg-ink text-white" aria-expanded="false" aria-controls="mnav" aria-label="Open menu" data-menu><Icon name="menu" size={22} class="block [[aria-expanded=true]>&]:hidden" /><Icon name="x" size={22} class="hidden [[aria-expanded=true]>&]:block" /></button>
      </div>
    </div>
    <nav id="mnav" class="hidden max-h-[calc(100vh-64px)] overflow-y-auto border-t border-line bg-white xl:hidden" aria-label="Mobile">
      <ul class="wrap py-3">
        {nav.map((i) => i.children ? i.children.map(([a, b, h]) => <li class="border-b border-line"><a href={h} class="flex items-baseline justify-between py-3.5 text-[16px] font-medium">{a} <span class="text-[13px] text-slate">{b}</span></a></li>) : <li class="border-b border-line"><a href={i.href} class:list={['block py-3.5 text-[16px] font-medium', active === i.key && 'font-semibold text-orange-dark']}>{i.label}</a></li>)}
        <li class="pt-4 pb-2"><a href="#proposal" class="btn btn-orange w-full" data-close>Request a Proposal</a></li>
      </ul>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="bg-ink pb-24 text-steel xl:pb-0">
    <div class="wrap grid gap-10 pt-16 pb-12 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.5fr)_repeat(4,minmax(0,1fr))] lg:gap-8 lg:pt-20">
      <div class="sm:col-span-2 lg:col-span-1">
        <Logo dark />
        <p class="mt-5 max-w-[320px] text-[15px] leading-relaxed">Commercial air-conditioning design, installation and maintenance for Sydney and the Hunter.</p>
        <p class="mt-7 text-[14px]">24/7 commercial breakdowns</p>
        <a href={tel} class="mt-1 inline-flex items-center gap-2 font-display text-[34px] font-bold text-white hover:text-orange sm:text-[40px]"><Icon name="phone" size={24} class="text-orange" />{phone}</a>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:col-span-2 lg:col-span-2 lg:gap-8">
        <div><p class="text-[14px] font-semibold text-white">Services</p><ul class="mt-4 space-y-3 text-[14.5px]">{fServices.map(([a, h]) => <li><a href={h} class="hover:text-white">{a}</a></li>)}</ul></div>
        <div><p class="text-[14px] font-semibold text-white">Company</p><ul class="mt-4 space-y-3 text-[14.5px]">{fCompany.map(([a, h]) => <li><a href={h} class="hover:text-white">{a}</a></li>)}</ul></div>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:col-span-2 lg:col-span-2">
        {[s, n].map((b) => <div class="text-[14px] sm:text-[14.5px]"><a href={b.href} class="font-semibold text-white hover:text-orange">{b.name} branch</a><p class="mt-4 leading-relaxed">{b.street}<br />{b.suburb}</p><a href={b.tel} class="mt-3 block font-semibold text-white hover:text-orange">{b.phone}</a><a href={`mailto:${b.email}`} class="mt-2 block text-[13px] break-all hover:text-white sm:text-[14px]">{b.email}</a><p class="mt-1 text-[13px] text-mute-2">Office Mon to Fri, 7am to 5pm</p></div>)}
        <p class="col-span-2 text-[12.5px] text-mute-2">Addresses, phone numbers and credentials are samples.</p>
      </div>
    </div>
    <div class="wrap">
      <div class="flex flex-col gap-3 border-t border-white/10 py-7 text-[13px] lg:flex-row lg:items-center lg:justify-between lg:py-9">
        <p class="text-mute-2 lg:order-1">© 2026 Corella Mechanical Pty Ltd. ABN 00 000 000 000 [sample]</p>
        <p class="order-first font-medium text-mist lg:order-2">Demo site by AirLeads Builder. This business is fictional.</p>
        <p class="flex gap-6 text-mute-2 lg:order-3"><span>Privacy</span><span>Terms</span></p>
      </div>
    </div>
  </footer>
  <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-line bg-white p-2.5 shadow-[0_-4px_16px_rgba(0,0,0,.08)] xl:hidden">
    <a href={tel} class="flex items-center gap-2.5 bg-ink px-3 py-2 text-white"><Icon name="phone" size={18} class="shrink-0 text-orange" /><span class="min-w-0 leading-tight"><span class="block truncate text-[10.5px] text-steel">24/7 breakdowns</span><span class="block text-[15px] font-semibold whitespace-nowrap">{phone}</span></span></a>
    <a href="#proposal" class="flex items-center justify-center bg-orange px-2 text-center text-[15px] font-semibold text-ink">Request a Proposal</a>
  </div>
  <script>
    const b = document.querySelector<HTMLButtonElement>('[data-menu]'), m = document.getElementById('mnav');
    const set = (o: boolean) => { b?.setAttribute('aria-expanded', String(o)); b?.setAttribute('aria-label', o ? 'Close menu' : 'Open menu'); m?.classList.toggle('hidden', !o); };
    b?.addEventListener('click', () => set(b.getAttribute('aria-expanded') !== 'true'));
    m?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  </script>
</body>
</html>
