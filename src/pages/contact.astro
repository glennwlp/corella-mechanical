---
import Base from '../layouts/Base.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServiceMap from '../components/ServiceMap.astro';
import Proposal from '../components/Proposal.astro';
import Icon from '../components/Icon.astro';
import { phone, tel, branches } from '../data/site';
const ways = [['New project or upgrade', 'Send drawings and site details through the proposal form below. A project engineer replies within one business day.', 'Go to the proposal form', '#proposal'], ['Existing maintenance contract', 'Log a non-urgent job, request reports or change visit dates through your site portal or your contracts coordinator.', 'Log in to the site portal', '#portal'], ['Everything else', 'Supplier enquiries, careers and accounts. Email the office and we will route it to the right person.', 'office@corellamech.com.au', 'mailto:office@corellamech.com.au']];
---
<Base title="Contact Corella Mechanical | Sydney and Newcastle" description="Breakdowns go straight to the on-call technician on 1300 000 222. Everything else goes to your nearest branch and gets a reply within one business day." active="contact">
  <section class="bg-ink text-white"><div class="wrap grid gap-10 py-10 sm:py-14 lg:min-h-[520px] lg:grid-cols-[minmax(0,600px)_minmax(0,544px)] lg:items-start lg:justify-between lg:py-[88px]">
    <div>
      <nav aria-label="Breadcrumb" class="text-[13.5px] text-steel"><a href="/" class="hover:text-white">Home</a><span class="mx-1.5">/</span><span aria-current="page">Contact</span></nav>
      <h1 class="h1 mt-5">Talk to the team that services your site</h1>
      <p class="mt-6 max-w-[560px] text-[16px] leading-relaxed text-fog sm:text-[18px]">Breakdowns go straight to the on-call technician. Everything else goes to your nearest branch and gets a reply within one business day.</p>
    </div>
    <div class="bg-orange p-6 text-ink sm:p-10">
      <h2 class="text-[26px] sm:text-[30px]">Commercial breakdown right now?</h2>
      <p class="mt-3 text-[15px] sm:text-[16px]">Answered 24 hours a day, every day of the year. Contract sites go to the front of the queue.</p>
      <a href={tel} class="mt-5 flex items-center gap-3 font-display text-[44px] font-bold leading-none hover:underline sm:text-[64px]"><Icon name="phone" size={36} class="shrink-0 sm:size-12" />{phone}</a>
      <p class="mt-5 text-[14px] font-medium">Technician dispatched within 30 minutes. On-site target 4 hours metro [sample].</p>
    </div>
  </div></section>
  <TrustStrip />
  <section class="sec"><div class="wrap grid gap-10 md:grid-cols-3 md:gap-4 lg:gap-4">
    {ways.map(([t, d, l, h]) => <div id={h === '#portal' ? 'portal' : undefined} class="border-t-2 border-ink pt-6 lg:pr-10"><h2 class="text-[26px] leading-tight sm:text-[28px]">{t}</h2><p class="mt-3 text-[15.5px] leading-relaxed text-body">{d}</p>{h === '#portal' ? <p class="mt-5"><span class="ulink text-[15px]">{l}</span><span class="mt-2 block text-[12.5px] text-mute">Client portal is not part of this demo.</span></p> : <a href={h} class="ulink mt-5 text-[15px] break-all">{l}</a>}</div>)}
  </div></section>
  <Proposal />
  <section class="sec bg-bg"><div class="wrap">
    <h2 class="h2">Visit or call a branch</h2>
    <div class="mt-10 grid gap-4 lg:mt-14 lg:grid-cols-2">
      {(['sydney', 'newcastle'] as const).map((k) => { const b = branches[k]; return (
        <article class="bg-white">
          <ServiceMap focus={k} compact />
          <div class="p-6 sm:p-8"><h3 class="text-[30px] sm:text-[32px]">{b.name}</h3><p class="text-[14px] text-body">{b.branch}</p><p class="mt-4 text-[15.5px]">{b.street}, {b.suburb}</p>
            <p class="mt-3 flex flex-wrap gap-x-8 gap-y-2"><a href={b.tel} class="inline-flex items-center gap-2 font-semibold hover:text-orange-dark"><Icon name="phone" size={16} class="text-orange" />{b.phone}</a><a href={`mailto:${b.email}`} class="text-[15px] text-body hover:text-ink">{b.email}</a></p>
            <p class="mt-4 text-[14px] text-body">Office Mon to Fri, 7am to 5pm. Breakdowns 24/7.</p>
            <a href={b.href} class="ulink mt-5 text-[15px]">View {b.name} branch</a></div>
        </article>); })}
    </div>
  </div></section>
</Base>
